{
  "name": "plakaty-parafialne",
  "productName": "Plakaty Parafialne",
  "version": "1.0.0",
  "description": "Plakaty i ogłoszenia Parafii pw. św. Jakuba Apostoła w Koziebrodach – generowane z pomocą Claude",
  "main": "src/main/main.js",
  "author": "z0z6",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "pl.z0z6.plakatyparafialne",
    "productName": "Plakaty Parafialne",
    "artifactName": "Plakaty-Parafialne-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "afterPack": "build/afterPack.js",
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "plakaty-parafialne",
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "Plakaty parafialne z pomocą AI",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Plakaty-Parafialne-${version}-portable.exe"
    },
    "publish": null
  },
  "desktopName": "plakaty-parafialne.desktop"
}
